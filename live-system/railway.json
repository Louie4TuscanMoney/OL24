{
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "uvicorn trading_dashboard_api:app --host 0.0.0.0 --port $PORT --reload",
    "healthcheckPath": "/",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "cron": [
    {
      "schedule": "30 3 * * *",
      "command": "cd live-system && python cron_daily_nba_update.py",
      "description": "Daily NBA data update at 3:30 AM UTC (standings, stats, schedule)"
    },
    {
      "schedule": "* * * * *",
      "command": "cd live-system && python cron_mamba_autonomous.py",
      "description": "Mamba autonomous predictions for ALL live games every minute"
    }
  ]
}
